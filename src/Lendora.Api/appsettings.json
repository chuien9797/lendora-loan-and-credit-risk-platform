{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=lendora_db;Username=lendora;Password=change-me"
  },
  "Jwt": {
    "Issuer": "Lendora",
    "Audience": "Lendora.Client",
    "Key": "CHANGE_ME_USE_ENVIRONMENT_VARIABLE_IN_REAL_DEPLOYMENTS",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "AdminSeed": {
    "FullName": "Lendora Admin",
    "Email": "admin@example.com",
    "Password": "CHANGE_ME_TEMPORARY_ADMIN_PASSWORD"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5122" ]
  },
  "DocumentStorage": {
    "Provider": "Local",
    "LocalRoot": ".appdata/uploads"
  },
  "DocumentOcr": {
    "Provider": "Disabled"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Lendora.Api"
    }
  },
  "AllowedHosts": "*"
}
