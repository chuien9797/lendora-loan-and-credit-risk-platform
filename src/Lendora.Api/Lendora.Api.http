@Lendora.Api_HostAddress = http://localhost:5081

GET {{Lendora.Api_HostAddress}}/health
Accept: application/json

###

GET {{Lendora.Api_HostAddress}}/api/platform/info
Accept: application/json

###

POST {{Lendora.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Demo Customer",
  "email": "customer@lendora.local",
  "password": "Password123"
}

###

POST {{Lendora.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@lendora.local",
  "password": "Admin12345"
}

###

GET {{Lendora.Api_HostAddress}}/api/loan-products
Authorization: Bearer {{token}}

